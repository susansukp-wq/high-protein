---
import Layout from '../layouts/Layout.astro'

/**
 * นโยบายความเป็นส่วนตัว
 *
 * หน้านี้เป็นข้อกำหนดที่ Google ตรวจจริงตอนพิจารณาอนุมัติ AdSense
 * และเป็นหน้าที่ตาม พ.ร.บ.คุ้มครองข้อมูลส่วนบุคคล (PDPA) ของไทย
 *
 * เนื้อหาเขียนตามสิ่งที่ระบบทำจริง ไม่ได้ก๊อปเทมเพลตมา —
 * ระบุชื่อ key ใน localStorage และชื่อตารางใน DB ตรงๆ เพื่อให้ตรวจสอบได้
 */
const updated = '24 สิงหาคม 2569'

const sections = [
  {
    title: 'ข้อมูลที่เราเก็บ',
    body: [
      'เว็บนี้ไม่มีระบบสมัครสมาชิก ไม่ขอเบอร์โทร และไม่ขออีเมล',
      'ถ้าคุณเลือกใช้ระบบจัดอันดับ เราจะเก็บ: ชื่อเล่นที่คุณตั้งเอง, เพศ, ส่วนสูง, น้ำหนัก, อายุ, ชื่ออาหารที่คุณกรอก, จำนวนแคลอรี่ และกิจกรรมที่เลือก',
      'ข้อมูลร่างกายถูกใช้เพื่อคำนวณอัตราการเผาผลาญ (BMR/TDEE) ของคุณเท่านั้น ไม่ถูกนำไปแสดงบนบอร์ดจัดอันดับ — บอร์ดแสดงเฉพาะชื่อเล่นและจำนวนนาทีที่สะสมได้',
      'ถ้าคุณไม่ตั้งชื่อเล่น จะไม่มีข้อมูลใดของคุณถูกส่งขึ้นเซิร์ฟเวอร์เลย ทุกอย่างคำนวณในเบราว์เซอร์ของคุณ',
    ],
  },
  {
    title: 'ข้อมูลที่เก็บในเครื่องคุณ (localStorage)',
    body: [
      'เราเก็บค่าต่อไปนี้ไว้ในเบราว์เซอร์ของคุณ ไม่ได้ส่งไปไหน:',
      'nmd:device-id — รหัสสุ่มที่ใช้จำว่าเครื่องนี้คือใคร แทนการล็อกอิน',
      'nmd:profile-id — รหัสโปรไฟล์ของคุณบนบอร์ดจัดอันดับ',
      'nmd:last-weight — น้ำหนักครั้งล่าสุด เพื่อไม่ต้องกรอกซ้ำ',
      'ล้างข้อมูลเว็บไซต์ในเบราว์เซอร์เมื่อไหร่ ค่าทั้งหมดนี้จะหายไป และเราจะจำคุณไม่ได้อีก',
    ],
  },
  {
    title: 'คุกกี้และโฆษณา',
    body: [
      'เว็บนี้ใช้ Google AdSense ในการแสดงโฆษณา',
      'Google และพันธมิตรอาจใช้คุกกี้เพื่อแสดงโฆษณาที่เกี่ยวข้องกับความสนใจของคุณ โดยอ้างอิงจากการเข้าชมเว็บไซต์นี้และเว็บไซต์อื่น',
      'คุณสามารถปิดการใช้คุกกี้เพื่อโฆษณาส่วนบุคคลได้ที่ google.com/settings/ads',
      'ดูวิธีที่ Google ใช้ข้อมูลได้ที่ policies.google.com/technologies/partner-sites',
    ],
  },
  {
    title: 'บริการภายนอกที่เราใช้',
    body: [
      'Supabase — ฐานข้อมูลที่เก็บชื่อเล่นและสถิติของผู้ใช้ระบบจัดอันดับ',
      'Cloudflare Pages — ผู้ให้บริการพื้นที่เว็บไซต์',
      'Google Fonts — ฟอนต์ภาษาไทยที่ใช้แสดงผล',
      'Google AdSense — ระบบโฆษณา',
      'เราไม่ได้ติดตั้ง Google Analytics หรือเครื่องมือติดตามพฤติกรรมอื่นใด',
    ],
  },
  {
    title: 'สิทธิของคุณตาม PDPA',
    body: [
      'คุณมีสิทธิขอดู แก้ไข หรือลบข้อมูลของคุณได้ตลอดเวลา',
      'วิธีที่เร็วที่สุดคือล้างข้อมูลเว็บไซต์ในเบราว์เซอร์ ซึ่งจะตัดความเชื่อมโยงระหว่างคุณกับข้อมูลบนเซิร์ฟเวอร์ทันที',
      'หากต้องการให้ลบข้อมูลออกจากฐานข้อมูลถาวร กรุณาติดต่อเราพร้อมแจ้งชื่อเล่นที่ใช้ เราจะดำเนินการให้ภายใน 30 วัน',
    ],
  },
  {
    title: 'ข้อจำกัดความรับผิดชอบ',
    body: [
      'ตัวเลขทั้งหมดบนเว็บนี้คำนวณจากค่า METs ตาม Compendium of Physical Activities ซึ่งเป็นค่าเฉลี่ยของประชากร ไม่ใช่ค่าเฉพาะบุคคล',
      'เนื้อหาบนเว็บนี้มีไว้เพื่อความบันเทิงและสร้างแรงจูงใจ ไม่ใช่คำแนะนำทางการแพทย์',
      'หากคุณมีโรคประจำตัว กำลังตั้งครรภ์ หรือมีภาวะเกี่ยวกับการกิน กรุณาปรึกษาแพทย์หรือนักกำหนดอาหารก่อนปรับพฤติกรรมการกินหรือการออกกำลังกาย',
      'ภาษาที่ใช้บนเว็บนี้เป็นการจิกกัดเชิงตลกเพื่อสร้างแรงจูงใจ ไม่ได้มีเจตนาดูหมิ่นรูปร่างของผู้ใด',
    ],
  },
]
---

<Layout
  title="นโยบายความเป็นส่วนตัว | ลดน้ำหนักไม่มีคำว่าปลอบใจ"
  description="เว็บนี้เก็บข้อมูลอะไรบ้าง ใช้คุกกี้อย่างไร และคุณมีสิทธิอะไรตาม PDPA — อธิบายตามที่ระบบทำงานจริง"
>
  <section class="px-4 py-12 sm:py-16">
    <div class="mx-auto max-w-3xl">
      <h1 class="font-display text-3xl font-black text-white sm:text-4xl">
        นโยบายความเป็นส่วนตัว
      </h1>
      <p class="mt-2 text-sm text-neutral-500">ปรับปรุงล่าสุด {updated}</p>

      <p class="mt-6 border-l-4 border-hazard bg-concrete px-5 py-4 text-base leading-relaxed text-neutral-300">
        สรุปสั้นที่สุด: ถ้าคุณแค่เข้ามาคำนวณเล่นแล้วปิดไป
        <strong class="text-white">เราไม่เก็บอะไรของคุณเลยสักอย่าง</strong>
        ข้อมูลจะถูกส่งขึ้นเซิร์ฟเวอร์ก็ต่อเมื่อคุณตั้งชื่อเล่นเพื่อเข้าระบบจัดอันดับเท่านั้น
      </p>

      <div class="mt-10 space-y-10">
        {
          sections.map((section) => (
            <section>
              <h2 class="font-display text-xl font-black text-hazard sm:text-2xl">
                {section.title}
              </h2>
              <ul class="mt-3 space-y-2">
                {section.body.map((line) => (
                  <li class="flex gap-3 text-sm leading-relaxed text-neutral-300">
                    <span class="shrink-0 text-steel">▸</span>
                    <span>{line}</span>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>

      <p class="mt-12 border-t-4 border-steel pt-6 text-sm text-neutral-400">
        มีคำถามเรื่องข้อมูลส่วนบุคคล? <a href="/contact" class="font-bold text-hazard underline underline-offset-2">ติดต่อเรา</a>
      </p>
    </div>
  </section>
</Layout>
