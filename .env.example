# ---- Supabase (Server-side only — ห้าม commit ไฟล์ .env จริง) ----
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # Dashboard > Project Settings > API > service_role

# ---- ใช้ฝั่ง Astro client (public) ----
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ---- Google AdSense (ไม่ใส่ก็ได้ — เว้นว่างไว้ระบบจะโชว์แค่ที่จองพื้นที่) ----
# หาได้จาก AdSense > Account > Settings > Account information > Publisher ID
# ต้องขึ้นต้นด้วย ca-pub- เสมอ
PUBLIC_ADSENSE_CLIENT_ID=
